# Database Configuration (Neon PostgreSQL)
# Use asyncpg driver for async support (format: postgresql+asyncpg://...)
# SSL is configured automatically in database.py
# Replace with your actual Neon connection string
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-xxx.aws.neon.tech/neondb

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
APP_NAME="AI Wiki Quiz Generator"
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings (Frontend URL)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Quiz Generation Settings
DEFAULT_NUM_QUESTIONS=10
MAX_NUM_QUESTIONS=20
